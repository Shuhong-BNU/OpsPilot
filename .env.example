# ==================================================
# OpsPilot 环境变量模板
# 首次运行前请先复制为 .env，再按本机环境填写真实值。
# 这里保留占位符，便于团队协作与项目分发。
# ==================================================

# ---------------- 应用基础配置 ----------------
# 应用名称、页面标题、版本号与服务监听地址。
APP_NAME=OpsPilot
APP_TITLE=基于 RAG 与 MCP 的智能运维助手
APP_VERSION=1.0.0
DEBUG=True
HOST=0.0.0.0
PORT=9900

# ---------------- 持久化与鉴权配置 ----------------
# SQLite 用于保存会话、消息、工作流记录与工具调用日志。
# JWT 与密码哈希参数决定本地登录与权限控制行为。
DATABASE_PATH=./data/opspilot.db
JWT_SECRET=replace-with-a-secure-secret
JWT_EXPIRE_MINUTES=720
PASSWORD_HASH_ITERATIONS=120000

# ---------------- 默认演示账号 ----------------
# 这些账号会在服务启动时自动确保存在，便于本地演示与联调。
DEFAULT_VIEWER_USERNAME=viewer
DEFAULT_VIEWER_PASSWORD=viewer123
DEFAULT_OPERATOR_USERNAME=operator
DEFAULT_OPERATOR_PASSWORD=operator123
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# ---------------- DashScope 大模型配置 ----------------
# 聊天模型、向量模型与 rerank 模型都会读取这里的配置。
# DASHSCOPE_API_KEY 需要替换为你自己的真实 Key。
DASHSCOPE_API_KEY=your-api-key
DASHSCOPE_MODEL=qwen-max
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_RERANK_MODEL=qwen3-rerank

# ---------------- Milvus 向量库配置 ----------------
# 负责稠密向量召回与相似度检索。
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_TIMEOUT=10000

# ---------------- RAG 检索与重排配置 ----------------
# 用于控制最终参考条数、稠密召回、稀疏召回、融合与重排规模。
RAG_TOP_K=3
RAG_MODEL=qwen-max
DENSE_TOP_K=6
SPARSE_TOP_K=6
HYBRID_TOP_K=4
RERANK_TOP_K=3

# ---------------- 文档切分配置 ----------------
# 控制知识库入库前的 chunk 大小与重叠长度。
CHUNK_MAX_SIZE=800
CHUNK_OVERLAP=100

# ---------------- MCP 工具服务配置 ----------------
# 当前项目默认通过 streamable-http 连接日志与监控 MCP 服务。
MCP_CLS_TRANSPORT=streamable-http
MCP_CLS_URL=http://localhost:8003/mcp
MCP_MONITOR_TRANSPORT=streamable-http
MCP_MONITOR_URL=http://localhost:8004/mcp

# ---------------- 指标与可观测性配置 ----------------
# 控制是否暴露轻量级 metrics 接口。
METRICS_ENABLED=True
